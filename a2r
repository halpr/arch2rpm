#!/usr/bin/env bash
#
# arch2rpm - convertion de paquets Arch Linux package (.pkg.tar.*) vers Fedora RPM.
#(RETIRER COMMENTAIRES ET PENSE-BETES AVANT DEPLOYEMENT)
# Portage de paquets Arch vers des distord RPM
#
# il faudra: bash 4.4+, tar, (zstd/xz/gzip as needed), rpmbuild (not for --spec-only)

set -Eeuo pipefail
shopt -s extglob nullglob

readonly PROG=arch2rpm
readonly VERSION=0.1

# ----------------------------------------------------------------- messages
if [[ -t 2 ]]; then
    C_G=$'\e[1;32m' C_B=$'\e[1;34m' C_Y=$'\e[1;33m' C_R=$'\e[1;31m' C_0=$'\e[0m'
else
    C_G= C_B= C_Y= C_R= C_0=
fi
msg()  { printf '%s==>%s %s\n'   "$C_G" "$C_0" "$*" >&2; }
msg2() { printf '%s  ->%s %s\n'  "$C_B" "$C_0" "$*" >&2; }
warn() { printf '%s==> WARNING:%s %s\n' "$C_Y" "$C_0" "$*" >&2; WARNINGS+=("$*"); }
die()  { printf '%s==> ERROR:%s %s\n'   "$C_R" "$C_0" "$*" >&2; exit 1; }
trap 'printf "%s==> ERROR:%s command failed (line %s): %s\n" "$C_R" "$C_0" "$LINENO" "$BASH_COMMAND" >&2' ERR

WARNINGS=()
WORK=

cleanup() {
    if [[ -n $WORK && -d $WORK ]] && (( ! KEEP_WORK )); then
        chmod -R u+rwX "$WORK" 2>/dev/null || true
        rm -rf "$WORK"
    fi
    return 0
}
trap cleanup EXIT

# ------------------------------------------------------------------ options
OUTDIR=$PWD
MAPFILE=
KEEP_VERSIONS=0 NO_DEPS=0 LIB64=0 NO_AUTOREQ=0 SPEC_ONLY=0 VERIFY=0 KEEP_WORK=0
PACKAGES=()

usage() {
    cat <<EOF
$PROG $VERSION - convertion de paquets Arch vers Fedora RPMs

Usage: $PROG [options] PACKAGE.pkg.tar.zst [...]

Options:
  -o, --outdir DIR     Where to put the result (default: current directory)
  -m, --map FILE       Extra dependency map, lines of "archname=fedora names"
                       (use "archname=-" to drop a dependency)
      --lib64          Move /usr/lib libraries to /usr/lib64 (x86_64/aarch64)
      --keep-versions  Keep version constraints on dependencies
      --no-deps        Do not emit any Requires
      --no-autoreq     Disable RPM's automatic ELF dependency detection
      --verify-deps    Check mapped dependencies exist in enabled dnf repos
      --spec-only      Write the .spec and payload tarball, but do not build
      --keep-workdir   Keep the temporary work directory for inspection
  -h, --help           Show this help
EOF
}

parse_args() {
    while (( $# )); do
        case $1 in
            -o|--outdir)     OUTDIR=${2:?missing value for $1}; shift ;;
            -m|--map)        MAPFILE=${2:?missing value for $1}; shift ;;
            --lib64)         LIB64=1 ;;
            --keep-versions) KEEP_VERSIONS=1 ;;
            --no-deps)       NO_DEPS=1 ;;
            --no-autoreq)    NO_AUTOREQ=1 ;;
            --verify-deps)   VERIFY=1 ;;
            --spec-only)     SPEC_ONLY=1 ;;
            --keep-workdir)  KEEP_WORK=1 ;;
            -h|--help)       usage; exit 0 ;;
            --)              shift; PACKAGES+=("$@"); break ;;
            -*)              usage >&2; die "Unknown option: $1" ;;
            *)               PACKAGES+=("$1") ;;
        esac
        shift
    done
    (( ${#PACKAGES[@]} )) || { usage >&2; exit 1; }
}

# ----------------------------------------------- Arch -> Fedora name mapping
# Values may list several Fedora packages; "-" drops the dependency. / Cela listera plusieurs paquets Fedora
