    [zstd]="libzstd"
    [lz4]="lz4-libs"
    [curl]="libcurl"
    [ncurses]="ncurses-libs"
    [readline]="readline"
    [sqlite]="sqlite-libs"
    [libffi]="libffi"
    [pcre]="pcre"
    [pcre2]="pcre2"
    [expat]="expat"
    [libxml2]="libxml2"
    [libxslt]="libxslt"
    [glib2]="glib2"
    [dbus]="dbus-libs"
