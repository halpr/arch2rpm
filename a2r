)
declare -A USER_MAP=()

load_mapfile() {
    [[ -n $MAPFILE ]] || return 0
    [[ -r $MAPFILE ]] || die "Cannot read map file: $MAPFILE"
    local line k v
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        [[ $line == *=* ]] || continue
        k=${line%%=*}; v=${line#*=}
        k=${k//[[:space:]]/}
        v=${v##+([[:space:]])}; v=${v%%+([[:space:]])}
        [[ -n $k ]] && USER_MAP[$k]=$v
    done < "$MAPFILE"
}

# map_dep "name[op ver][: description]"  ->  zero or more Fedora requirement lines / zero ou plusieures lignes d'exigence
map_dep() {
    local dep=$1 name op= ver= mapped m
    local -a words
    dep=${dep%%: *}                      # strip optdepend description
    if [[ $dep =~ ^([^\<\>=]+)(\<=|\>=|\<|\>|=)(.+)$ ]]; then
        name=${BASH_REMATCH[1]} op=${BASH_REMATCH[2]} ver=${BASH_REMATCH[3]}
    else
        name=$dep
    fi
    name=${name//[[:space:]]/}
    [[ -n $name ]] || return 0

    # Arch soname dependencies (libfoo.so=1-64): RPM's autoreq covers these.
    [[ $name == *.so || $name == *.so.* ]] && return 0
    [[ $name == lib32-* ]] && return 0

    if   [[ -n ${USER_MAP[$name]+x} ]];    then mapped=${USER_MAP[$name]}
    elif [[ -n ${BUILTIN_MAP[$name]+x} ]]; then mapped=${BUILTIN_MAP[$name]}
    elif [[ $name == python-* ]];          then mapped=python3-${name#python-}
    else mapped=$name
    fi
    [[ $mapped == - ]] && return 0

    read -ra words <<<"$mapped"
    for m in "${words[@]}"; do
        if (( KEEP_VERSIONS )) && [[ -n $op ]] && (( ${#words[@]} == 1 )); then
            printf '%s %s %s\n' "$m" "$op" "$ver"
        else
            printf '%s\n' "$m"
        fi
    done
}

# ----------------------------------------------------------- .PKGINFO parse
declare -A INFO
DEPENDS=() OPTDEPENDS=() PROVIDES=() CONFLICTS=() REPLACES=() LICENSES=() BACKUP=()

parse_pkginfo() {
    local file=$1 line key val
    INFO=()
    DEPENDS=() OPTDEPENDS=() PROVIDES=() CONFLICTS=() REPLACES=() LICENSES=() BACKUP=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        key=${line%% = *}
        val=${line#* = }
        [[ $line == *' = '* ]] || val=
        case $key in
            depend)    DEPENDS+=("$val") ;;
            optdepend) OPTDEPENDS+=("$val") ;;
            provides)  PROVIDES+=("$val") ;;
            conflict)  CONFLICTS+=("$val") ;;
            replaces)  REPLACES+=("$val") ;;
            license)   LICENSES+=("$val") ;;
            backup)    BACKUP+=("$val") ;;
            *)         INFO[$key]=$val ;;
        esac
    done < "$file"
    [[ -n ${INFO[pkgname]:-} && -n ${INFO[pkgver]:-} ]] \
        || die ".PKGINFO is missing pkgname or pkgver"
}

# ------------------------------------------------------- payload adjustments
# Directories under /usr/lib that must stay put (systemd, udev, python, ...). / Répertoires dans /usr/lib qui devront rester
lib_keep() {
    case $1 in
        systemd|udev|sysusers.d|tmpfiles.d|modules|modules-load.d|modprobe.d|\
        binfmt.d|sysctl.d|firmware|kernel|dracut|os-release|environment.d|\
        python3*|pam.d|ostree|sysimage) return 0 ;;
    esac
    return 1
}

move_lib64() {
    [[ -d $ROOT/usr/lib ]] || return 0
    case $RPMARCH in x86_64|aarch64) ;; *) return 0 ;; esac

    msg2 "Moving /usr/lib libraries to /usr/lib64..."
    local entry base l t b pc
    local -a moved=()
    mkdir -p "$ROOT/usr/lib64"
    for entry in "$ROOT"/usr/lib/*; do
        base=${entry##*/}
        lib_keep "$base" && continue
        mv -n "$entry" "$ROOT/usr/lib64/$base"
        moved+=("$base")
    done

    # Absolute symlinks that pointed into the moved trees. / Liens symboliques absolus (à corriger si nécessaire)
    while IFS= read -r -d '' l; do
        t=$(readlink "$l")
        [[ $t == /usr/lib/* ]] || continue
        b=${t#/usr/lib/}; b=${b%%/*}
        if [[ " ${moved[*]:-} " == *" $b "* ]]; then
            ln -sfn "/usr/lib64/${t#/usr/lib/}" "$l"
        fi
    done < <(find "$ROOT" -type l -print0)

    # pkg-config files: libdir=/usr/lib -> /usr/lib64
    for pc in "$ROOT"/usr/lib64/pkgconfig/*.pc; do
        sed -i -E 's#^(libdir=.*)/lib$#\1/lib64#' "$pc"
    done
    [[ " ${moved[*]:-} " == *" cmake "* ]] \
        && warn "CMake config files may still reference /usr/lib; check them."
    return 0
}

# --------------------------------------------------------------- %files
# Directories that other packages (filesystem, etc.) already own. Heuristic. / Pas besoin de péciser, classique
should_own_dir() {
    local d=$1 tmp depth
    tmp=${d//[^\/]/}
    depth=$(( ${#tmp} + 1 ))
    (( depth <= 2 )) && return 1            # usr/bin, usr/lib, usr/share, etc/...

    case $d in
        # direct children of usr/share that are shared system locations
        usr/share/@(man|doc|licenses|locale|icons|applications|pixmaps|metainfo|\
appdata|info|mime|help|themes|fonts|sounds|backgrounds|menu|dbus-1|polkit-1|\
bash-completion|zsh|fish|vala|gir-1.0|glib-2.0|cmake|pkgconfig|aclocal|gtk-doc|\
desktop-directories|mime-info|gnome|kde|autostart|X11|xsessions|wayland-sessions))
            return 1 ;;
        usr/share/man/*|usr/share/info/*|usr/share/locale/*|usr/share/icons/*) return 1 ;;
        usr/share/bash-completion/*|usr/share/zsh/*|usr/share/fish/*) return 1 ;;
        usr/share/dbus-1/*|usr/share/polkit-1/*|usr/share/vala/*|usr/share/mime/*) return 1 ;;
        usr/share/glib-2.0/*|usr/share/gir-1.0/*|usr/share/metainfo/*) return 1 ;;
        usr/lib/@(systemd|udev|sysusers.d|tmpfiles.d|modprobe.d|modules-load.d|sysctl.d|binfmt.d|pkgconfig)) return 1 ;;
        usr/lib/systemd/*|usr/lib/udev/*|usr/lib/python3*|usr/lib64/python3*) return 1 ;;
        usr/lib64/@(pkgconfig|cmake)|usr/lib64/pkgconfig/*) return 1 ;;
        etc/@(systemd|udev|xdg|profile.d|ld.so.conf.d|cron.d|logrotate.d|sudoers.d|\
pam.d|security|sysctl.d|modprobe.d|dbus-1|bash_completion.d|default|skel)) return 1 ;;
        var/@(lib|log|cache|spool|tmp|run)) return 1 ;;
    esac
    return 0
}

declare -A IS_CONF

generate_files_list() {
    local out=$1 p rel tag esc
    IS_CONF=()
    local b
    for b in "${BACKUP[@]:-}"; do [[ -n $b ]] && IS_CONF[${b#/}]=1; done

    {
        printf '%%defattr(-,root,root,-)\n'
        while IFS= read -r -d '' p; do
            rel=${p#./}
            should_own_dir "$rel" || continue
            esc=${rel//'%'/'%%'}
            printf '%%dir "/%s"\n' "$esc"
        done < <(cd "$ROOT" && find . -mindepth 1 -type d -print0 | sort -z)

        while IFS= read -r -d '' p; do
            rel=${p#./}
            esc=${rel//'%'/'%%'}
            tag=
            if [[ -n ${IS_CONF[$rel]+x} ]]; then tag='%config(noreplace) '
            elif [[ $rel == usr/share/licenses/* ]]; then tag='%license '
            fi
            printf '%s"/%s"\n' "$tag" "$esc"
        done < <(cd "$ROOT" && find . -mindepth 1 \( -type f -o -type l \) -print0 | sort -z)
    } > "$out"
}

# ------------------------------------------------------------- scriptlets
INSTALL_FILE=

has_fn() {
    [[ -n $INSTALL_FILE && -f $INSTALL_FILE ]] || return 1
    grep -Eq "^[[:space:]]*(function[[:space:]]+)?$1[[:space:]]*(\(\s*\))?[[:space:]]*\{?" "$INSTALL_FILE"
}

# emit_section <rpm section> <fn run on install> <fn run on upgrade> <fn run on removal> / section parfaite, rien à changer
emit_section() {
    local sec=$1 inst=$2 upg=$3 rem=$4 fn have=0
    for fn in $inst $upg $rem; do has_fn "$fn" && have=1; done
    (( have )) || return 0

    printf '\n%%%s\n' "$sec"
    cat <<'EOF'
bash -s -- "$1" "%{version}-%{release}" <<'ARCH_INSTALL_EOF' || :
EOF
    sed 's/%/%%/g' "$INSTALL_FILE"
    printf '\n_cnt=$1; _ver=$2\n'
    [[ -n $inst ]] && has_fn "$inst" && printf '[ "$_cnt" -eq 1 ] && %s "$_ver"\n' "$inst"
    [[ -n $upg  ]] && has_fn "$upg"  && printf '[ "$_cnt" -ge 2 ] && %s "$_ver" ""\n' "$upg"
    [[ -n $rem  ]] && has_fn "$rem"  && printf '[ "$_cnt" -eq 0 ] && %s "$_ver"\n' "$rem"
    printf ':\nARCH_INSTALL_EOF\n'
}

# ------------------------------------------------------------------- spec
emit_tag() { # emit_tag Tag line...
    local tag=$1 l; shift
    for l in "$@"; do [[ -n $l ]] && printf '%s: %s\n' "$tag" "$l"; done
    return 0
}

unique_sorted() { sort -u | sed '/^$/d'; }

write_spec() {
    local spec=$1
    local -a reqs=() sugg=() prov=() conf=() obs=()
    local d

    if (( ! NO_DEPS )); then
        for d in "${DEPENDS[@]:-}";    do [[ -n $d ]] && mapfile -t -O "${#reqs[@]}" reqs < <(map_dep "$d"); done
        for d in "${OPTDEPENDS[@]:-}"; do [[ -n $d ]] && mapfile -t -O "${#sugg[@]}" sugg < <(map_dep "$d"); done
        [[ -n $INSTALL_FILE ]] && reqs+=(bash)
        mapfile -t reqs < <(printf '%s\n' "${reqs[@]:-}" | unique_sorted)
        mapfile -t sugg < <(printf '%s\n' "${sugg[@]:-}" | unique_sorted)
    fi

    for d in "${PROVIDES[@]:-}"; do
        [[ -z $d || $d == *.so* ]] && continue
        if [[ $d =~ ^([^=]+)=(.+)$ ]]; then prov+=("${BASH_REMATCH[1]} = ${BASH_REMATCH[2]}")
        else prov+=("$d"); fi
    done
    for d in "${CONFLICTS[@]:-}"; do mapfile -t -O "${#conf[@]}" conf < <(map_dep "$d"); done
    for d in "${REPLACES[@]:-}";  do mapfile -t -O "${#obs[@]}"  obs  < <(map_dep "$d"); done

    local license=
    if (( ${#LICENSES[@]} )); then
        printf -v license '%s AND ' "${LICENSES[@]}"; license=${license% AND }
    else
        license=Unknown
    fi

    {
        printf '# Generated by %s %s from %s\n' "$PROG" "$VERSION" "${PKGFILE##*/}"
        printf '# Binary repack of an Arch Linux package. Review before distributing.\n\n'
        cat <<'EOF'
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __strip /bin/true
%global _build_id_links none
%global _missing_build_ids_terminate_build 0
%global _binaries_in_noarch_packages_terminate_build 0

EOF
        printf 'Name:           %s\n'    "$NAME"
        printf 'Version:        %s\n'    "$VER"
        printf 'Release:        %s%%{?dist}\n' "$REL"
        [[ -n $EPOCH ]] && printf 'Epoch:          %s\n' "$EPOCH"
        printf 'Summary:        %s\n'    "${SUMMARY//'%'/'%%'}"
        printf 'License:        %s\n'    "${license//'%'/'%%'}"
        [[ -n ${INFO[url]:-} ]] && printf 'URL:            %s\n' "${INFO[url]//'%'/'%%'}"
        printf 'Source0:        %s\n'    "$PAYLOAD_NAME"
        [[ $RPMARCH == noarch ]] && printf 'BuildArch:      noarch\n'
        (( NO_AUTOREQ )) && printf 'AutoReq:        no\n'
        emit_tag Requires    "${reqs[@]:-}"
        emit_tag Recommends  "${sugg[@]:-}"
        emit_tag Provides    "${prov[@]:-}"
        emit_tag Conflicts   "${conf[@]:-}"
        emit_tag Obsoletes   "${obs[@]:-}"

        printf '\n%%description\n%s\n\n' "${SUMMARY//'%'/'%%'}"
        printf 'Repackaged from the Arch Linux package %s-%s by %s.\n' "$NAME" "${INFO[pkgver]}" "$PROG"

        cat <<'EOF'

%prep
# Nothing to unpack: the payload is extracted directly in %install.

%build
# Prebuilt binaries.

%install
mkdir -p %{buildroot}
tar -xpf %{SOURCE0} -C %{buildroot} --no-same-owner
EOF

        emit_section pre    pre_install  pre_upgrade  ""
        emit_section post   post_install post_upgrade ""
        emit_section preun  ""           ""           pre_remove
        emit_section postun ""           ""           post_remove

        printf '\n%%files\n'
        cat "$FILES_LIST"

        printf '\n%%changelog\n'
        printf '* %s %s - %s-%s\n- Repackaged from Arch Linux with %s\n' \
            "$(LC_ALL=C date '+%a %b %d %Y')" "${PACKAGER:-arch2rpm <noreply@localhost>}" \
            "$VER" "$REL" "$PROG"
    } > "$spec"
}

verify_deps() {
    command -v dnf >/dev/null || { warn "dnf not found; cannot verify dependencies."; return 0; }
    msg "Verifying dependencies against dnf repositories..."
    local d
    while IFS= read -r d; do
        [[ -n $d && $d != /* ]] || continue
        d=${d%% *}
        if [[ -z $(dnf -q repoquery --whatprovides "$d" 2>/dev/null | head -n1) ]]; then
            warn "No Fedora package provides '$d' (add a mapping with --map)."
        fi
    done < <(grep -E '^(Requires|Recommends):' "$1" | sed -E 's/^[A-Za-z]+:[[:space:]]+//')
}

# --------------------------------------------------------------- conversion
convert_one() {
    PKGFILE=$1
    [[ -f $PKGFILE ]] || die "No such file: $PKGFILE"
    msg "Converting ${PKGFILE##*/}"

    WORK=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX")
    ROOT=$WORK/root
    mkdir -p "$ROOT" "$WORK"/rpmbuild/{SOURCES,SPECS,BUILD,RPMS,SRPMS}

    msg2 "Extracting package..."
    tar -xpf "$PKGFILE" -C "$ROOT" --no-same-owner \
        || die "Could not extract $PKGFILE (is it an Arch package? is zstd installed?)"
    [[ -f $ROOT/.PKGINFO ]] || die "$PKGFILE has no .PKGINFO; not an Arch package."

    parse_pkginfo "$ROOT/.PKGINFO"

    # Arch metadata that has no place in an RPM.
    INSTALL_FILE=
    if [[ -f $ROOT/.INSTALL ]]; then
        INSTALL_FILE=$WORK/install.sh
        cp "$ROOT/.INSTALL" "$INSTALL_FILE"
    fi
    rm -f "$ROOT"/.{PKGINFO,BUILDINFO,MTREE,INSTALL,CHANGELOG}

    NAME=${INFO[pkgname]}
    local full=${INFO[pkgver]}
    EPOCH=
    if [[ $full == *:* ]]; then EPOCH=${full%%:*}; full=${full#*:}; fi
    REL=${full##*-}
    VER=${full%-*}; VER=${VER//-/_}
    SUMMARY=${INFO[pkgdesc]:-$NAME}

    case ${INFO[arch]:-any} in
        any)     RPMARCH=noarch ;;
        x86_64|aarch64|riscv64|i686) RPMARCH=${INFO[arch]} ;;
        armv7h)  RPMARCH=armv7hl ;;
        *)       die "Unsupported architecture: ${INFO[arch]}" ;;
    esac

    [[ -n $(ls -A "$ROOT") ]] || die "Package contains no files."

    (( LIB64 )) && move_lib64
    if [[ -d $ROOT/usr/lib && $RPMARCH != noarch ]] \
       && find "$ROOT/usr/lib" -maxdepth 2 -name '*.so*' -print -quit | grep -q .; then
        (( LIB64 )) || warn "Shared libraries are in /usr/lib; Fedora uses /usr/lib64 (try --lib64)."
    fi
    [[ -d $ROOT/usr/sbin && ! -L $ROOT/usr/sbin ]] && \
        warn "Package ships /usr/sbin; Fedora merges sbin into bin and the install may conflict."

    PAYLOAD_NAME=$NAME-$VER-payload.tar
    msg2 "Creating payload tarball..."
    tar -C "$ROOT" --sort=name --numeric-owner --owner=0 --group=0 \
        -cf "$WORK/rpmbuild/SOURCES/$PAYLOAD_NAME" .

    FILES_LIST=$WORK/files.list
    generate_files_list "$FILES_LIST"

    local spec=$WORK/rpmbuild/SPECS/$NAME.spec
    msg2 "Writing spec file..."
    write_spec "$spec"
    (( VERIFY )) && verify_deps "$spec"

    mkdir -p "$OUTDIR"
    if (( SPEC_ONLY )); then
        cp "$spec" "$WORK/rpmbuild/SOURCES/$PAYLOAD_NAME" "$OUTDIR/"
        msg "Wrote $OUTDIR/$NAME.spec and $OUTDIR/$PAYLOAD_NAME"
        msg2 "Build with: rpmbuild -bb --target $RPMARCH --define \"_sourcedir $OUTDIR\" $OUTDIR/$NAME.spec"
        return 0
    fi

    command -v rpmbuild >/dev/null || die "rpmbuild not found (sudo dnf install rpm-build), or use --spec-only."
    msg2 "Building RPM..."
    rpmbuild -bb --quiet \
        --target "$RPMARCH" \
        --define "_topdir $WORK/rpmbuild" \
        --define "_rpmdir $OUTDIR" \
        --define "_rpmfilename %%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}.rpm" \
        "$spec"

    local rpm
    rpm=$(ls -t "$OUTDIR"/"$NAME"-*.rpm 2>/dev/null | head -n1)
    msg "Finished: ${rpm:-$OUTDIR}"
}

main() {
    parse_args "$@"
    load_mapfile
    local p
    for p in "${PACKAGES[@]}"; do
        convert_one "$p"
        cleanup; WORK=
    done

    if (( ${#WARNINGS[@]} )); then
        printf '\n%sReview before installing (%d warning(s)):%s\n' "$C_Y" "${#WARNINGS[@]}" "$C_0" >&2
        printf '  - %s\n' "${WARNINGS[@]}" >&2
    fi
}

main "$@"
